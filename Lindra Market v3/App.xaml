<Application x:Class="Lindra_Market_v3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Lindra_Market_v3"
             xmlns:utils="clr-namespace:Lindra_Market_v3.Utils"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme (Light / Dark / auto-switches via SystemThemeWatcher in code) -->
                <ui:ThemesDictionary Theme="Dark" />
                <!-- All WPF-UI control styles/templates -->
                <ui:ControlsDictionary />
                <!-- Language dictionary -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Languages/Strings.fr.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <utils:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

            <!-- Win11 / Fluent Windows Slider Style -->
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#38B6FF" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid x:Name="RootGrid" SnapsToDevicePixels="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Track with Decrease/Increase RepeatButtons and Thumb -->
                                <Track x:Name="PART_Track" Grid.Row="1" VerticalAlignment="Center">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Style="{x:Null}"
                                                      OverridesDefaultStyle="True"
                                                      Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Border Height="6"
                                                            CornerRadius="3,0,0,3"
                                                            Background="#38B6FF"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Style="{x:Null}"
                                                      OverridesDefaultStyle="True"
                                                      Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Border Height="6"
                                                            CornerRadius="0,3,3,0"
                                                            Background="{DynamicResource SliderTrackFill}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb"
                                               Style="{x:Null}"
                                               OverridesDefaultStyle="True"
                                               Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Grid Width="20" Height="20" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <!-- Outer ring -->
                                                        <Ellipse x:Name="OuterRing"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Fill="{DynamicResource SliderOuterThumbBackground}"
                                                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                                 StrokeThickness="1" />
                                                        <!-- Inner accent dot -->
                                                        <Ellipse x:Name="InnerDot"
                                                                 Width="10"
                                                                 Height="10"
                                                                 Fill="#38B6FF"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                            <Setter TargetName="InnerDot" Property="Width" Value="12" />
                                                            <Setter TargetName="InnerDot" Property="Height" Value="12" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="OuterRing" Property="Fill" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                                            <Setter TargetName="InnerDot" Property="Width" Value="9" />
                                                            <Setter TargetName="InnerDot" Property="Height" Value="9" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
