<Page x:Class="Lindra_Market_v3.Tools.FpsUnlocker.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Lindra_Market_v3.Tools.FpsUnlocker.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Background="Transparent"
      PreviewMouseWheel="Page_PreviewMouseWheel"
      Title="SettingsPage">

    <ScrollViewer x:Name="PageScrollViewer"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40" MaxWidth="680">

            <!-- Page Header -->
            <ui:TextBlock Text="{DynamicResource FpsSettings_PageTitle}"
                          FontTypography="Title"
                          Margin="0,0,0,4" />
            <ui:TextBlock Text="{DynamicResource FpsSettings_PageSubtitle}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,0,0,24" />

            <!-- SECTION GESTION PROFIL -->
            <ui:TextBlock Text="{DynamicResource FpsSettings_Sec_Profile}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,12" />

            <StackPanel Margin="0,0,0,24">

                <!-- Save JSON Card -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Save_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Save_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="{DynamicResource FpsSettings_Save_Btn}"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Click="SaveConfig_Click" />
                </ui:CardControl>

                <!-- Load JSON Card -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Load_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Load_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="{DynamicResource FpsSettings_Load_Btn}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Appearance="Secondary"
                               Click="LoadConfig_Click" />
                </ui:CardControl>

                <!-- Reset Card -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Reset_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource FpsSettings_Reset_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="ArrowReset24" />
                    </ui:CardControl.Icon>
                    <ui:Button Content="{DynamicResource FpsSettings_Reset_Btn}"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Appearance="Secondary"
                               Click="ResetConfig_Click" />
                </ui:CardControl>

            </StackPanel>

            <!-- Status / Info Bar -->
            <ui:InfoBar x:Name="StatusInfoBar"
                        Title="{DynamicResource FpsSettings_InfoBar_Title}"
                        Message="{DynamicResource FpsSettings_Info_Initial}"
                        IsOpen="True"
                        Severity="Informational"
                        IsClosable="False"
                        Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
