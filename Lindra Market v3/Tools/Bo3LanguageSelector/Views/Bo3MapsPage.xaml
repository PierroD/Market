<Page x:Class="Lindra_Market_v3.Tools.Bo3LanguageSelector.Views.Bo3MapsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Lindra_Market_v3.Tools.Bo3LanguageSelector.Views"
      xmlns:models="clr-namespace:Lindra_Market_v3.Tools.Bo3LanguageSelector.Models"
      xmlns:utils="clr-namespace:Lindra_Market_v3.Utils"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="950"
      Title="Bo3MapsPage"
      Background="Transparent"
      PreviewMouseWheel="Page_PreviewMouseWheel"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <utils:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </Page.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <!-- Header & Filter Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Batch progress banner -->
            <RowDefinition Height="Auto" />
            <!-- Maps content area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header + Filter Toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Header Titles -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Bo3Lang_Maps_PageTitle}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Bo3Lang_Maps_PageSubtitle}"
                               FontSize="13"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnPatchAll"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Content="{DynamicResource Bo3Lang_Btn_PatchAll}"
                               Margin="0,0,8,0"
                               Click="BtnPatchAll_Click" />

                    <ui:Button x:Name="BtnRefresh"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               Content="{DynamicResource Bo3Lang_Btn_Refresh}"
                               Click="BtnRefresh_Click" />
                </StackPanel>
            </Grid>

            <!-- Search and Language Toolbar Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <ui:TextBox x:Name="SearchTextBox"
                                Grid.Column="0"
                                Margin="0,0,16,0"
                                Icon="{ui:SymbolIcon Search24}"
                                PlaceholderText="{DynamicResource Bo3Lang_Search_Placeholder}"
                                TextChanged="SearchTextBox_TextChanged" />

                    <!-- Target Language Dropdown -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Bo3Lang_TargetLang_Label}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <ComboBox x:Name="TargetLangComboBox"
                                  Width="180"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="TargetLangComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ROW 1: Batch Progress Banner -->
        <Border x:Name="BatchProgressCard"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtBatchStatus"
                               Text="Patch des cartes en cours..."
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TxtBatchPercent"
                               HorizontalAlignment="Right"
                               Text="0%"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <ProgressBar x:Name="BatchProgressBar" Height="6" Minimum="0" Maximum="100" Value="0" />
            </StackPanel>
        </Border>

        <!-- ROW 2: Content Area (List / Loading / Empty) -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel x:Name="LoadingPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" Margin="0,0,0,16" />
                <TextBlock Text="Chargement des cartes Workshop..."
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <Border x:Name="EmptyStatePanel"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="550"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="FolderSearch24"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    <TextBlock Text="{DynamicResource Bo3Lang_NoMaps_Title}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock Text="{DynamicResource Bo3Lang_NoMaps_Desc}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               LineHeight="18"
                               Margin="0,0,0,20"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Settings24}"
                               Content="{DynamicResource Bo3Lang_Nav_Settings}"
                               HorizontalAlignment="Center"
                               Click="BtnGoToSettings_Click" />
                </StackPanel>
            </Border>

            <!-- Maps Virtualized List -->
            <ScrollViewer x:Name="PageScrollViewer"
                          Background="Transparent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MapsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Bo3MapItem}">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Thumbnail -->
                                        <ColumnDefinition Width="150" />
                                        <!-- Map info -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Actions -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Thumbnail image or placeholder -->
                                    <Border Grid.Column="0"
                                            Height="90"
                                            CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            ClipToBounds="True"
                                            Margin="0,0,16,0">
                                        <Grid>
                                            <!-- Image if thumbnail exists -->
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />

                                            <!-- Placeholder if no thumbnail -->
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}">
                                                <ui:SymbolIcon Symbol="Games24"
                                                               FontSize="24"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,4"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{DynamicResource Bo3Lang_Map_NoThumbnail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Middle: Title, Folder, Tags, Installed Languages -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding FolderName}"
                                                       FontSize="12"
                                                       Opacity="0.65"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text=" • ID: "
                                                       FontSize="12"
                                                       Opacity="0.4"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding PublisherId}"
                                                       FontSize="12"
                                                       Opacity="0.65"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <!-- Installed languages badges -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Bo3Lang_Map_InstalledLangs}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                                            <ItemsControl ItemsSource="{Binding InstalledLanguages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource AccentFillColorTertiaryBrush}"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,4,0">
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Right: Action buttons -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- If already patched for target language -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsTargetLanguageInstalled, Converter={StaticResource BoolToVis}}">
                                            <Border Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                                    BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Checkmark16"
                                                                   FontSize="14"
                                                                   Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{DynamicResource Bo3Lang_Map_Btn_Patched}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Remove button -->
                                            <ui:Button Appearance="Secondary"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Content="{DynamicResource Bo3Lang_Map_Btn_Unpatch}"
                                                       Tag="{Binding}"
                                                       Margin="0,0,8,0"
                                                       Click="BtnUnpatch_Click" />
                                        </StackPanel>

                                        <!-- If NOT patched for target language -->
                                        <ui:Button Appearance="Primary"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Content="{DynamicResource Bo3Lang_Map_Btn_Patch}"
                                                   Tag="{Binding}"
                                                   Margin="0,0,8,0"
                                                   Visibility="{Binding IsTargetLanguageInstalled, Converter={StaticResource InvBoolToVis}}"
                                                   Click="BtnPatch_Click" />

                                        <!-- Folder button -->
                                        <ui:Button Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                                   Tag="{Binding}"
                                                   ToolTip="{DynamicResource Bo3Lang_Map_Btn_Folder}"
                                                   Margin="0,0,6,0"
                                                   Click="BtnOpenFolder_Click" />

                                        <!-- Workshop link button -->
                                        <ui:Button Appearance="Secondary"
                                                   Icon="{ui:SymbolIcon Globe24}"
                                                   Tag="{Binding}"
                                                   ToolTip="{DynamicResource Bo3Lang_Map_Btn_Workshop}"
                                                   Click="BtnOpenWorkshop_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
