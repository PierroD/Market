<Page x:Class="Lindra_Market_v3.Tools.Bo3LanguageSelector.Views.Bo3SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Lindra_Market_v3.Tools.Bo3LanguageSelector.Views"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Bo3SettingsPage"
      Background="Transparent"
      PreviewMouseWheel="Page_PreviewMouseWheel"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer x:Name="PageScrollViewer"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20,24,32" MaxWidth="900">
            <!-- Header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{DynamicResource Bo3Lang_Settings_PageTitle}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource Bo3Lang_Settings_PageSubtitle}"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- SECTION 1: Steam Workshop Path -->
            <TextBlock Text="{DynamicResource Bo3Lang_Settings_Sec_Path}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,24">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Bo3Lang_Settings_Path_Title}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource Bo3Lang_Settings_Path_Sub}"
                                       FontSize="12"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="BtnAutoDetect"
                                       Appearance="Secondary"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Content="{DynamicResource Bo3Lang_Settings_Btn_AutoDetect}"
                                       Margin="0,0,8,0"
                                       Click="BtnAutoDetect_Click" />

                            <ui:Button x:Name="BtnBrowse"
                                       Appearance="Primary"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       Content="{DynamicResource Bo3Lang_Settings_Btn_Browse}"
                                       Click="BtnBrowse_Click" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBox x:Name="TxtWorkshopPath"
                                Margin="0,12,0,0"
                                PlaceholderText="e.g. C:\Program Files (x86)\Steam\steamapps\workshop\content\311210"
                                TextChanged="TxtWorkshopPath_TextChanged" />

                    <!-- Path validation badge -->
                    <StackPanel x:Name="PnlPathStatus"
                                Orientation="Horizontal"
                                Margin="0,8,0,0"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="IconPathStatus"
                                       Symbol="CheckmarkCircle24"
                                       FontSize="16"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="TxtPathStatus"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Favorite Language -->
            <TextBlock Text="{DynamicResource Bo3Lang_Settings_Sec_FavLang}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Bo3Lang_Settings_FavLang_Title}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Bo3Lang_Settings_FavLang_Sub}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox x:Name="CmbFavLanguage"
                              Grid.Column="1"
                              Width="220"
                              VerticalAlignment="Center"
                              DisplayMemberPath="Name"
                              SelectionChanged="CmbFavLanguage_SelectionChanged" />
                </Grid>
            </Border>

            <!-- SECTION 3: How it works -->
            <TextBlock Text="{DynamicResource Bo3Lang_Settings_Sec_HowItWorks}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Symbol="Info28"
                                   FontSize="24"
                                   Grid.Column="0"
                                   Margin="0,2,16,0"
                                   VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />

                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Bo3Lang_Settings_HowItWorks_Text}"
                               FontSize="13"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
