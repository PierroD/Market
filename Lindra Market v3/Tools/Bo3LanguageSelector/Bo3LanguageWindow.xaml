<ui:FluentWindow x:Class="Lindra_Market_v3.Tools.Bo3LanguageSelector.Bo3LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lindra_Market_v3.Tools.Bo3LanguageSelector"
        xmlns:views="clr-namespace:Lindra_Market_v3.Tools.Bo3LanguageSelector.Views"
        mc:Ignorable="d"
        Title="{DynamicResource Bo3Lang_WindowTitle}"
        Height="720"
        Width="1050"
        MinWidth="820"
        MinHeight="600"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Icon="pack://application:,,,/Assets/app.png">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Bo3Lang_WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Navigation View -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="LeftMinimal"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            IsPaneOpen="False">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Bo3Lang_Nav_Maps}"
                    Icon="{ui:SymbolIcon Games24}"
                    TargetPageType="{x:Type views:Bo3MapsPage}" />

                <ui:NavigationViewItem
                    Content="{DynamicResource Bo3Lang_Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type views:Bo3SettingsPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!-- Status bar at bottom -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Workshop folder path -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <ui:SymbolIcon Symbol="Folder24"
                                   FontSize="14"
                                   Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="TxtFooterPath"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Right: Detected maps count -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1">
                    <TextBlock x:Name="TxtFooterCount"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
