<Page x:Class="Lindra_Market_v3.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:utils="clr-namespace:Lindra_Market_v3.Utils"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="850"
      Background="Transparent"
      PreviewMouseWheel="Page_PreviewMouseWheel"
      Title="AboutPage">

    <ScrollViewer x:Name="PageScrollViewer"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,40" MaxWidth="720">

            <!-- En-tête de la page -->
            <ui:TextBlock Text="{DynamicResource About_PageTitle}"
                          FontTypography="Title"
                          Margin="0,0,0,4" />
            <ui:TextBlock Text="{DynamicResource About_PageSubtitle}"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                          Margin="0,0,0,24" />

            <!-- HERO CARD : Identité de l'application -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon Badge -->
                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            CornerRadius="14"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="UniformToFill" />
                    </Border>

                    <!-- App Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                            <ui:TextBlock Text="{DynamicResource About_Hero_Title}"
                                          FontTypography="TitleLarge"
                                          FontWeight="Bold"
                                          Margin="0,0,12,0" />

                            <!-- Version Pill -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HeroVersionText"
                                           Text="{x:Static utils:AppVersionHelper.Version}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>

                            <!-- Arch Pill -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text=".NET 10 • x64"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </Border>
                        </StackPanel>

                        <ui:TextBlock Text="{DynamicResource About_Hero_Desc}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      FontTypography="Body"
                                      TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- SECTION 1 : LIENS & RESSOURCES -->
            <ui:TextBlock Text="{DynamicResource About_Sec_Links}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,12" />

            <StackPanel Margin="0,0,0,24">
                <!-- Dépôt GitHub -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource About_Github_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource About_Github_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </ui:CardControl.Icon>
                    <ui:Button Appearance="Primary"
                               Icon="{ui:SymbolIcon Open24}"
                               Content="{DynamicResource About_Github_Btn}"
                               Click="OnVisitGithubClick" />
                </ui:CardControl>

                <!-- Signaler un bug -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource About_Report_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource About_Report_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Bug24" />
                    </ui:CardControl.Icon>
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Open24}"
                               Content="{DynamicResource About_Report_Btn}"
                               Click="OnReportIssueClick" />
                </ui:CardControl>

                <!-- FAQ & Documentation -->
                <ui:CardControl Margin="0,0,0,8">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock Text="{DynamicResource About_Faq_Title}" FontTypography="BodyStrong" />
                            <ui:TextBlock Text="{DynamicResource About_Faq_Sub}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </ui:CardControl.Icon>
                    <ui:Button Appearance="Secondary"
                               Icon="{ui:SymbolIcon Open24}"
                               Content="{DynamicResource About_Faq_Btn}"
                               Click="OnVisitFaqClick" />
                </ui:CardControl>
            </StackPanel>

            <!-- SECTION 2 : INFORMATIONS SYSTÈME & DIAGNOSTIC -->
            <ui:TextBlock Text="{DynamicResource About_Sec_System}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,12" />

            <ui:Card Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Card Header with Copy Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <ui:TextBlock Text="{DynamicResource About_System_Sub}"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      FontTypography="Caption"
                                      VerticalAlignment="Center" />

                        <ui:Button x:Name="CopySystemInfoButton"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Copy24}"
                                   Content="{DynamicResource About_System_CopyBtn}"
                                   HorizontalAlignment="Right"
                                   Click="OnCopySystemInfoClick" />
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,0,0,16" />

                    <!-- Technical specs grid -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- OS -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,14">
                            <ui:TextBlock Text="{DynamicResource About_System_OS}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                            <TextBlock x:Name="SysOsText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Architecture -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,14">
                            <ui:TextBlock Text="{DynamicResource About_System_Arch}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                            <TextBlock x:Name="SysArchText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Runtime -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                            <ui:TextBlock Text="{DynamicResource About_System_Runtime}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                            <TextBlock x:Name="SysRuntimeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- UI Framework -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
                            <ui:TextBlock Text="{DynamicResource About_System_UiFramework}"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          FontTypography="Caption" />
                            <TextBlock Text="WPF-UI v4.2.1"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- SECTION 3 : AVERTISSEMENT LÉGAL -->
            <ui:TextBlock Text="{DynamicResource About_Sec_Disclaimer}"
                          FontTypography="Subtitle"
                          Margin="0,0,0,12" />

            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="Info24"
                                   FontSize="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,14,0" />

                    <ui:TextBlock Grid.Column="1"
                                  Text="{DynamicResource About_Disclaimer_Text}"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  FontTypography="Caption"
                                  TextWrapping="Wrap"
                                  LineHeight="18" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
