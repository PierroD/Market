<ui:FluentWindow x:Class="Lindra_Market_v3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Lindra_Market_v3"
        xmlns:views="clr-namespace:Lindra_Market_v3.Views"
        mc:Ignorable="d"
        Title="MainWindow"
        Width="1100"
        Height="700"
        MinWidth="600"
        MinHeight="400"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar that matches the Fluent/Mica window chrome -->
        <ui:TitleBar
            Grid.Row="0"
            Title="LINDRA's Market">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Navigation shell: left rail + content frame -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_Home}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type views:HomePage}" />
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type views:SettingsPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{DynamicResource Nav_About}"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type views:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>

</ui:FluentWindow>
